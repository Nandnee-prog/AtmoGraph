# ===== Neo4j AuraDB Free =====
# AuraDB account banate waqt jo credentials file download hoti hai, usse values copy karna
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# ===== App settings =====
# true = precomputed predictions serve karo (PyG deploy fallback)
USE_PRECOMPUTED=false
CORS_ORIGINS=http://localhost:5173
